#!/usr/bin/env bash
# Pre-push gate — FAST by default: `make lint` + `make lint-frontend`.
#
# `make lint` covers: WIT drift, the structural lints (`bash
# scripts/lint-structural.sh --count` for the live number — this comment
# deliberately doesn't state one; a hardcoded count drifted 40→49 undetected
# by 2026-07-01) including rustfmt (check 35), and offline cargo-deny
# (bans/licenses/sources). `make lint-frontend` covers eslint + prettier.
# Both are the single source of truth for "the gate" — this hook deliberately
# does NOT re-spell the checks so it can't drift from the Make targets.
#
# WHAT IS NOT HERE BY DEFAULT, AND WHY (2026-09-25): workspace clippy (check
# 7) and vitest. Until then this hook ran both on every push, so a one-line
# Rust fix paid for a cold clippy build (minutes) that quality.yml then ran
# AGAIN on the PR — the same check twice, the local copy bypassable with
# --no-verify and the CI copy not. CI is the authority; the local gate's job
# is to fail fast on the cheap mistakes (formatting, a structural rule, a lint
# warning in the frontend). Opt back into the full set with
#
#     TALOS_PREPUSH_FULL=1 git push        # make lint-full + lint-frontend-full
#
# which is worth doing before a push you expect to be the last one on a PR.
#
# ── PATH GATING ──────────────────────────────────────────────────────────
# Both gates used to run UNCONDITIONALLY, so a docs-only push paid for a
# full-workspace clippy and a Rust-only push paid for the entire frontend
# eslint+prettier+vitest suite. Each gate now runs only when the pushed range
# touches files it can possibly have an opinion about.
#
# This does not weaken CI: `quality.yml` runs every suite a change can affect
# on every PR and in the merge queue, so anything skipped here is still gated
# before merge. What changes is only WHERE you find out.
#
# THE ONE REAL COUPLING, stated rather than buried: the frontend consumes
# TypeScript types generated from the Rust GraphQL schema, so a Rust-only
# change CAN invalidate frontend types. That is a pre-existing gap, not one
# introduced here — nothing in this hook (before or after path gating) re-runs
# codegen, so the frontend suite it used to run was type-checking STALE
# generated types and would not have caught the break either. Path gating
# makes that gap marginally easier to reach, and the honest fix is a codegen
# step in the gate, not an unconditional `npm run lint`. Until then: after a
# GraphQL schema change, run `make lint-frontend` yourself once codegen has
# been re-run.
#
# Detection is deliberately conservative — anything it cannot classify runs
# BOTH gates (see the "unknown range" fallback below), so the failure
# direction is "ran too much", never "skipped a gate".
#
# Install with `make hooks` (sets core.hooksPath=.githooks).
# Emergency bypass for a WIP/docs push: `git push --no-verify`,
# or `SKIP_LINT=1 git push`. Force both gates regardless of paths with
# `FORCE_LINT=1 git push`.
set -euo pipefail

if [ "${SKIP_LINT:-0}" = "1" ]; then
    echo "pre-push: SKIP_LINT=1 set — skipping the lint gates."
    exit 0
fi

repo_root="$(git rev-parse --show-toplevel)"

# ── Which files does this push actually contain? ─────────────────────────
# git feeds pre-push `<local ref> <local sha> <remote ref> <remote sha>` on
# stdin, one line per ref. A remote sha of all-zeros means a NEW branch, for
# which there is no meaningful "range" — fall back to running everything.
changed_files=""
unknown_range=0
zero="0000000000000000000000000000000000000000"

while read -r _local_ref local_sha _remote_ref remote_sha; do
    [ -z "${local_sha:-}" ] && continue
    # Deleting a remote branch — nothing to lint.
    [ "$local_sha" = "$zero" ] && continue
    if [ "${remote_sha:-$zero}" = "$zero" ] || \
       ! git -C "$repo_root" cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
        unknown_range=1
        break
    fi
    range_files="$(git -C "$repo_root" diff --name-only "$remote_sha" "$local_sha" 2>/dev/null || true)"
    if [ -z "$range_files" ] && [ "$remote_sha" != "$local_sha" ]; then
        # Could not compute a diff for a range we thought was valid.
        unknown_range=1
        break
    fi
    changed_files="$changed_files
$range_files"
done

# Non-interactive callers (or a manual `bash .githooks/pre-push`) give no
# stdin at all; treat that as "cannot tell" rather than "nothing changed".
if [ "${FORCE_LINT:-0}" = "1" ]; then
    unknown_range=1
elif [ -z "$(printf '%s' "$changed_files" | tr -d '[:space:]')" ] && [ "$unknown_range" -eq 0 ]; then
    unknown_range=1
fi

if [ "$unknown_range" -eq 1 ]; then
    run_rust=1
    run_frontend=1
    echo "pre-push: could not scope the pushed range (new branch, or FORCE_LINT) — running both gates."
else
    run_rust=0
    run_frontend=0
    # Rust gate: anything clippy/rustfmt/cargo-deny/structural-lint can see.
    # Deliberately broad — the structural lints read shell scripts, Helm
    # charts, alert rules and migrations too, so a narrow `*.rs` filter would
    # skip the gate on exactly the files checks 5/44/65/66 exist for.
    # `CLAUDE.md` is in the list because meta-check 54 compares its
    # "N checks today" sentence against the script's live count, so a
    # CLAUDE.md-only edit CAN break the gate.
    if printf '%s\n' "$changed_files" | grep -qE '\.(rs|toml|lock|sql|wit|sh|ya?ml)$|^wit/|^migrations/|^scripts/|^deploy/|^observability/|^Makefile$|^CLAUDE\.md$'; then
        run_rust=1
    fi
    if printf '%s\n' "$changed_files" | grep -qE '^frontend/'; then
        run_frontend=1
    fi
    if [ "$run_rust" -eq 0 ] && [ "$run_frontend" -eq 0 ]; then
        echo "pre-push: pushed range touches neither Rust/infra nor frontend files — no gate applies."
    fi
fi

if [ "${TALOS_PREPUSH_FULL:-0}" = "1" ]; then
    rust_target=lint-full
    frontend_target=lint-frontend-full
else
    rust_target=lint
    frontend_target=lint-frontend
fi

if [ "$run_rust" -eq 1 ]; then
    echo "pre-push: running 'make $rust_target' (bypass with --no-verify; full set: TALOS_PREPUSH_FULL=1)…"
    if ! make -C "$repo_root" "$rust_target"; then
        echo
        echo "✗ pre-push: 'make $rust_target' failed — push blocked."
        echo "  Fix the reported issues, or for an emergency push bypass with:"
        echo "      git push --no-verify"
        exit 1
    fi
else
    echo "pre-push: no Rust/infra files in this push — skipping 'make $rust_target' (quality.yml still runs it)."
fi

if [ "$run_frontend" -eq 1 ]; then
    echo "pre-push: running 'make $frontend_target'…"
    if ! make -C "$repo_root" "$frontend_target"; then
        echo
        echo "✗ pre-push: 'make $frontend_target' failed — push blocked."
        echo "  Fix the reported issues, or for an emergency push bypass with:"
        echo "      git push --no-verify"
        exit 1
    fi
else
    echo "pre-push: no frontend/ files in this push — skipping 'make $frontend_target' (quality.yml still runs it)."
fi
