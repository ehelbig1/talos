# Rust
target/
**/*.rs.bk
*.pdb

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Environment files
.env
.env.local
.env.*.local
.env.production

# Docker
docker-compose.override.yml

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Logs
*.log

# Coverage and profiling
*.profraw
frontend/coverage/

# Database
*.db
*.sqlite

# SOC 2 evidence exports (contain audit data — never commit)
evidence/

# SDK build artifacts
# Python bytecode. Was path-specific to sdks/python/ until 2026-09-22, when
# scripts/lint_lib/ became the first importable package under scripts/ and
# every `make lint` started leaving an untracked directory behind.
__pycache__/
*.pyc
sdks/python/*.egg-info/
sdks/python/dist/
sdks/typescript/dist/
sdks/typescript/node_modules/

# Claude and other AI assistants
.codex/
.claude/*
# …but DO track the shared web-session hook + its registration so all
# sessions get the same setup. Personal/local overrides stay ignored.
!.claude/settings.json
!.claude/hooks/
.claude/settings.local.json

# Temporary build/debug output
controller/check_output*.txt
controller/errors.txt
fix_mutations*.py
test_null
test_type.rs

# Backup files
*.bak
*.rs.bak

# Heredoc markers (shell artifacts)
B64EOF
EOF
PYEOF

# Playwright test artifacts
frontend/playwright-report/
frontend/test-results/

# Module template build artifacts (Cargo.lock per-template)
module-templates/*/Cargo.lock

# Proptest regression files
**/proptest-regressions/

# WIT backup/snippet files
wit/*.bak
wit/*.snippet

# Design documents (binary)
*.docx

# Release artifact (regenerated by `make release`; pinned digests live in install.env on the prod VM)
release-digests.txt
release-digests.txt.tmp
