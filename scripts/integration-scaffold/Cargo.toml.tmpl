[package]
name = "talos-__ID__"
version.workspace = true
edition.workspace = true
rust-version.workspace = true
license.workspace = true
publish.workspace = true

[dependencies]
anyhow.workspace = true
async-trait.workspace = true
axum = { workspace = true, features = ["json"] }
chrono.workspace = true
reqwest = { workspace = true, features = ["json", "rustls"] }
serde.workspace = true
serde_json.workspace = true
sqlx = { workspace = true, features = ["postgres", "runtime-tokio", "tls-rustls-ring-webpki", "macros", "uuid", "chrono"] }
talos-config = { path = "../talos-config" }
talos-dlp-provider = { path = "../talos-dlp-provider" }
talos-http-body = { path = "../talos-http-body" }
talos-http-utils = { path = "../talos-http-utils" }
talos-oauth = { path = "../talos-oauth" }
talos-text-util = { path = "../talos-text-util" }
tracing.workspace = true
urlencoding.workspace = true
uuid.workspace = true

[dev-dependencies]
# `connect_lazy` needs a runtime; the unit tests touch no database.
tokio = { workspace = true, features = ["macros", "rt"] }

